<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>win-adapter-doctor</AssemblyName><RootNamespace>WinDiagnostics</RootNamespace><Version>1.0.0</Version><Description>Inspect network adapters, addresses, gateways, DNS configuration, and interface counters.</Description><EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /><EmbeddedResource Include="Collector.ps1" LogicalName="Collector.ps1" Condition="Exists('Collector.ps1')" /></ItemGroup>
</Project>
